# Quiz Global Production Environment Variables
# Copy this file to .env and fill in the production values
# NEVER commit the .env file to version control

# ===== Django Settings =====
DEBUG=False
DJANGO_SECRET_KEY=your_long_random_secret_key_here_keep_it_secret
ALLOWED_HOSTS=www.quiz.global,quiz.global

# ===== Database Configuration (PostgreSQL) =====
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=quiz_global
DATABASE_USER=quiz_user
DATABASE_PASSWORD=your_strong_database_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ===== Google OAuth Configuration =====
GOOGLE_APP_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_APP_SECRET=your_google_oauth_client_secret_here

# ===== Google Gemini API =====
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Email Configuration (Optional - for password resets) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password_here
DEFAULT_FROM_EMAIL=noreply@quiz.global

# ===== Redirect Hosts =====
REDIRECT_HOSTS=www.quiz.global,quiz.global
